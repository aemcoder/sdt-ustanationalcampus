    {
     "role": "heading",
     "order": 0,
     "text": "Programs"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Junior Tennis"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Our recreational and competitive pathways help players ages 4-17 develop a passion for tennis in a fun environment."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Learn More",
     "href": "/en/home/play/programs/junior-tennis-programs.html"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Adult Tennis"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Get healthy and socialize by playing tennis with our cardio and instructional tennis programs. Adult programs are open to all levels and offer daily options."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Learn More",
     "href": "https://www.ustanationalcampus.com/en/home/play/programs/adult-tennis.html"
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Performance Academy"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Focused on high level tournament youth players competing in state, sectional, and/or national USTA tournaments."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Learn More",
     "href": "/en/home/play/high-performance1.html"
    },
    {
     "role": "heading",
     "order": 10,
     "text": "GET STARTED WITH A FREE 30"
    },
    {
     "role": "body",
     "order": 11,
     "text": "New players can book a free 30-minute intro session to get tips and program recommendations"
    },
    {
     "role": "cta",
     "order": 12,
     "text": "BOOK A FREE SESSION",
     "href": "/en/home/play/free30.html"
    },
    {
     "role": "heading",
     "order": 13,
     "text": "Pickleball"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Learn the basics or take your game to the next level with skill-building programs and various match play opportunities."
    },
    {
     "role": "cta",
     "order": 15,
     "text": "Learn More",
     "href": "https://www.ustanationalcampus.com/en/home/play/pickleball.html"
    },
    {
     "role": "heading",
     "order": 16,
     "text": "Padel"
    },
    {
     "role": "body",
     "order": 17,
     "text": "Discover our new programs, improve your skills with private lessons, or compete in a league—all on our world-class courts."
    },
    {
     "role": "cta",
     "order": 18,
     "text": "Learn More",
     "href": "/en/home/play/play-padel.html"
    },
    {
     "role": "heading",
     "order": 19,
     "text": "Red Ball Tennis for Adults Community Drop-In"
    },
    {
     "role": "body",
     "order": 20,
     "text": "Our community drop-in is designed for absolute beginners, making it fun and easy to fall in love with tennis."
    },
    {
     "role": "body",
     "order": 21,
     "text": "free"
    },
    {
     "role": "cta",
     "order": 22,
     "text": "Learn More",
     "href": "https://www.ustanationalcampus.com/en/home/play/tennis/adult-red-ball.html"
    },
    {
     "role": "heading",
     "order": 23,
     "text": "Dave Bailey Tennis Movement and Footwork"
    },
    {
     "role": "body",
     "order": 24,
     "text": "Footwork program integrates agility drills, plyometrics, and tennis-specific movements to enhance speed, coordination, and overall athletic performance."
    },
    {
